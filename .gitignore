# Lista blanca: todo queda fuera salvo lo permitido abajo.
# Para publicar algo nuevo, agregar una excepción explícita.
/*
!/.gitignore
!/README.md

# Documentación técnica neutra preparada para revisión; no implica publicación.
!/especificacion.md
!/schema.sql
!/Guia_MVP_Timetabling_Codex.md
!/AGENTS.md
!/CLAUDE.md
!/docs/
/docs/*
!/docs/decisiones.md
!/docs/colaboracion.md
!/docs/encargos/
/docs/encargos/*
!/docs/encargos/hito-0.md
!/docs/encargos/hito-1.md
!/docs/encargos/hito-2.md
!/docs/entregas/
/docs/entregas/*
!/docs/entregas/hito-0.md

# Hito 0: paquete y entorno. Cada hito agrega solo sus rutas.
!/pyproject.toml
!/.python-version
!/uv.lock
!/src/
/src/*
!/src/academic_timetabling_demo/
/src/academic_timetabling_demo/*
!/src/academic_timetabling_demo/__init__.py
!/src/academic_timetabling_demo/__main__.py
!/src/academic_timetabling_demo/cli.py
!/tests/
/tests/*
!/tests/test_cli.py

# Hito 1: datos y validación.
!/docs/entregas/hito-1.md
!/src/academic_timetabling_demo/domain.py
!/src/academic_timetabling_demo/db.py
!/src/academic_timetabling_demo/synthetic.py
!/tests/test_domain.py
!/tests/test_db.py
!/tests/test_synthetic.py
!/data/
/data/*
!/data/synthetic/
/data/synthetic/*
!/data/synthetic/micro/
!/data/synthetic/demo/

# Hito 2: candidatos SQL.
!/docs/entregas/hito-2.md
!/src/academic_timetabling_demo/candidates.py
!/tests/test_candidates.py

# Hito 3: CP-SAT, auditoría y corridas.
!/.gitattributes
!/docs/encargos/hito-3.md
!/docs/entregas/hito-3.md
!/src/academic_timetabling_demo/model.py
!/src/academic_timetabling_demo/validate.py
!/src/academic_timetabling_demo/runner.py
!/src/academic_timetabling_demo/metrics.py
!/tests/test_model.py
!/tests/test_audit.py
!/tests/test_runner.py

# Hito 4: heurística voraz y comparación.
!/docs/encargos/hito-4.md
!/docs/entregas/hito-4.md
!/src/academic_timetabling_demo/baseline.py
!/src/academic_timetabling_demo/compare.py
!/tests/test_baseline.py
!/tests/test_compare.py

# Hito 5: exportaciones y demostración.
!/docs/encargos/hito-5.md
!/docs/entregas/hito-5.md
!/src/academic_timetabling_demo/report.py
!/src/academic_timetabling_demo/templates/
/src/academic_timetabling_demo/templates/*
!/src/academic_timetabling_demo/templates/schedule.html
!/scripts/
/scripts/*
!/scripts/demo_change.py
!/tests/test_report.py
!/tests/test_demo_change.py
!/tests/test_demo_set.py
# Conjunto de demostración revisado; runs/ sigue ignorado.
!/docs/demo/
/docs/demo/*
!/docs/demo/README.md
!/docs/demo/preview.png
!/docs/demo/comparison.json
!/docs/demo/cpsat/
!/docs/demo/greedy/
!/docs/demo/changed/

# Siempre excluidos, aunque una regla anterior abra su carpeta.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
/runs/
# El material local y los PDF siguen excluidos por la lista blanca raíz.
